import QmlProject

Project {
    mainFile: "content/App.qml"
    mainUiFile: "content/App.qml"

    QmlFiles {
        directory: "content"
    }

    QmlFiles {
        directory: "designer"
    }

    ImageFiles {
        directory: "content/assets"
    }

    Files {
        filter: "qmldir"
        directory: "."
    }

    Environment {
        // UiManager calls QQuickStyle::setStyle("Basic") before any QML is loaded. The designer loads the
        // QML without that C++, and the controls in content/ replace their backgrounds and delegates,
        // which a native style refuses.
        QT_QUICK_CONTROLS_STYLE: "Basic"
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"
    }

    qt6Project: true
    qdsVersion: "4.8"
    quickVersion: "6.8"
    widgetApp: true

    // Supplies the usbdiskimager.qml module: QML stand-ins for the singletons UiManager registers from
    // C++, which no designer process can create. content/ resolves itself through its own qmldir.
    importPaths: [ "designer" ]
}
